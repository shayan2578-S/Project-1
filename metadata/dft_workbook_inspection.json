        ],
        [
          "subtitle",
          "Analysis of Connectivity to key services by different transport modes"
        ],
        [
          "version_date",
          "21/08/2025"
        ],
        [
          "public release version",
          "V1.0.0"
        ],
        [
          "publisher",
          "Department for Transport"
        ],
        [
