          "connectivity@dft.gov.uk"
        ],
        [
          "publication_frequency",
          "Annual (tentative)"
        ],
        [
          "next update",
          "TBD"
        ],
        [
          "statistical designation",
          "Experimental Statistics"
        ],
        [
          "Sensitivity",
          "OFFICIAL"
        ],
        [
          "description",
          "This dataset provides measures of connectivity to key services by different modes of transport at Output Area (OA), Lower Super Output Area (LSOA), Local Authority District (LAD) and regional (RGN) level. It shows how easily residents can reach important destinations such as workplaces, schools, hospitals, and shops using different transport modes."
        ],
        [
          "geographical coverage",
          "England and Wales"
        ],
        [
          "lowest geography",
          "Output Area (OA 2021)"
        ],
        [
          "highest geography",
          "Region"
        ],
        [
          "time period",
          "Q4 (October to December 2024)"
        ],
        [
          "methodology summary",
          "Connectivity is calculated using journey planning algorithms considering actual transport networks and service timetables, the total value of all destinations within reach, and the propensity to travel to each destination type by each transport mode at different times of day. Scores represent the ease of access to services, with higher scores indicating better connectivity."
        ],
        [
          "score definition",
          "connectivity scores range from 0 to 100, where 100 represents the highest level of connectivity."
        ],
        [
          "decile definition",
          "Areas are ranked by connectivity and divided into 10 equal groups (deciles). 1 represents the lowest connectivity, 10 represents the highest."
        ],
        [
          "transport modes",
          "car: Private car transport"
        ],
        [
          "",
          "public transport: Bus, train, and other public transport services"
        ],
        [
          "",
          "cycling: Bicycle transport"
        ],
        [
          "",
          "walking: Travel by foot"
        ],
        [
          "journey purposes",
          "journey purposes"
        ],
        [
          "",
          "education: Travel to schools and educational facilities"
        ],
        [
          "",
          "health: Travel to healthcare facilities"
        ],
        [
          "",
          "leisure and community : Travel to entertainment and public activity venues"
        ],
        [
          "",
          "shopping: Travel to retail locations"
        ],
        [
          "",
          "residential: Travel to residential addresses for social purposes"
        ],
        [
          "usage notes",
          "1. OA/LSOA codes can be linked to other geographical datasets"
        ],
        [
          "",
          "2. Scores should be interpreted relative to other areas"
        ],
        [
          "",
          "3. Different transport modes should not be directly compared"
        ],
        [
          "",
          "4. connectivity may vary by time of day."
        ],
        [
          "data quality",
          "Data has undergone quality assurance. Known limitations include:"
        ],
        [
          "",
          "1. Based on theoretical journey times"
        ],
        [
          "",
          "2. Does not account for service disruptions"
        ],
        [
          "",
          "3. Assumes services operating as timetabled"
        ],
        [
          "related publications",
          "1. National Travel Survey"
        ],
        [
          "",
          "2. Journey Time Statistics"
        ],
